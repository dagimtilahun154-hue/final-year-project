# ─────────────────────────────────────────────
# Ankelba Backend — Environment Configuration
# Copy this file to .env and fill in real values
# NEVER commit .env to version control
# ─────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=5000

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ankelba_dev
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT Authentication (NFR-SEC-07, FR-UAM-07)
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_strong_random_secret_at_least_64_chars
JWT_EXPIRES_IN=24h

# AI Parent Guide (TBD-03 — placeholder until advisor confirms provider)
AI_API_KEY=placeholder_replace_when_provider_confirmed
AI_API_BASE_URL=https://api.example.com/v1

# Chapa Payment Gateway (TBD-02 — sandbox key for development)
CHAPA_SECRET_KEY=placeholder_replace_with_chapa_sandbox_key
CHAPA_WEBHOOK_SECRET=placeholder_replace_with_chapa_webhook_secret
